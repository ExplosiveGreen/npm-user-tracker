{
  "expo": {
    "name": "npm user tracker",
    "slug": "npm-user-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "mynpm",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar"
    ]
  }
}